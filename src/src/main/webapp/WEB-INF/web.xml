<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                             https://jakarta.ee/xml/ns/jakartaee/web-app_5_0.xsd"
         id="WebApp_ID" version="5.0">

  <display-name>AgenziaAffitti</display-name>

  <!-- Alternativa al file db.properties: decommentare per usare context-param
  <context-param>
    <param-name>driver</param-name>
    <param-value>com.mysql.cj.jdbc.Driver</param-value>
  </context-param>
  <context-param>
    <param-name>connection</param-name>
    <param-value>jdbc:mysql://localhost:3306/AgenziaAffitti?user=agenziauser&amp;password=unapasswd</param-value>
  </context-param>
  -->

  <servlet>
    <description></description>
    <display-name>AgenziaAffitti</display-name>
    <servlet-name>AgenziaAffitti</servlet-name>
    <servlet-class>it.agenzia.controller.AgenziaAffitti</servlet-class>
  </servlet>
  <!-- NON USARE il mapping qui sotto: essendoci @WebServlet("/AgenziaAffitti")
       andrebbe in conflitto.
  <servlet-mapping>
    <servlet-name>AgenziaAffitti</servlet-name>
    <url-pattern>/AgenziaAffitti</url-pattern>
  </servlet-mapping>
  -->

  <welcome-file-list>
    <welcome-file>AgenziaAffitti</welcome-file>
  </welcome-file-list>

</web-app>
